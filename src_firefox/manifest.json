{
	"manifest_version": 3,
	"name": "ClickControl\u2122",
	"version": "1.0",
	"default_locale": "en",
	"description": "__MSG_descripcion__",
	"incognito": "split",
	"permissions": 
	[
		"storage",
		"tabs",
		"webNavigation"
	],
	"host_permissions": 
	[
		"<all_urls>"
	],
	"background": 
	{
		"scripts": ["engine/guardian.js"],
		"type": "module"
	},
	"action": 
	{
		"default_popup": "ui/menu.html",
		"default_icon": 
		{
			"128": "img/icono.png"
		}
	},
	"icons": 
	{
		"128": "img/icono.png"
	},
	"web_accessible_resources": 
	[{
		"resources": 
		[
			"ui/*",
			"img/*"
		],
		"matches": ["<all_urls>"]
	}],
	"browser_specific_settings": 
	{
		"gecko": 
		{
			"id": "clickcontrol@fodsoft.com",
			"strict_min_version": "109.0"
		}
	}
}