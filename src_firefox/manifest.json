{
    "manifest_version": 3,
    "name": "ClickControl",
    "version": "1.2",
    "default_locale": "en",
    "description": "__MSG_desc__",

    "permissions": [
        "storage",
        "tabs",
        "webNavigation",
        "scripting",
        "webRequest",
        "alarms"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "scripts": ["engine/guardian.js"],
        "type": "module"
    },

    "action": {
        "default_popup": "ui/menu.html",
        "default_icon": {
            "64": "img/icon.png"
        }
    },

    "icons": {
        "64": "img/icon.png"
    },

    "web_accessible_resources": [{
        "resources": [
            "ui/*",
            "img/*"
        ],
        "matches": ["<all_urls>"]
    }],

    "browser_specific_settings": {
        "gecko": {
            "id": "clickcontrol@fodsoft.com",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": [ "none" ]
            }
        },
        "gecko_android": {
            "strict_min_version": "128.0"
        }
    }
}